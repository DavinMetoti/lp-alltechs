{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/our-clients/layout,_N_T_/our-clients/page,_N_T_/our-clients"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
